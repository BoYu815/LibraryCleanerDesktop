{
  "name": "library-cleaner-desktop",
  "version": "2.1.1",
  "private": true,
  "description": "按项目自动定位和监测 GPT/Codex 与 DeepSeek 的本地生成文件",
  "author": "Local build",
  "main": "src/local-main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.cjs",
    "start": "npm run prepare:app && electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "npm run prepare:app && electron . --smoke-test",
    "dist": "npm run prepare:app && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "opencc-js": "1.4.2"
  },
  "build": {
    "appId": "local.librarycleaner.desktop",
    "productName": "生成文件管家",
    "executableName": "LibraryCleaner",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/local/**/*",
      "src/local-main.cjs",
      "src/local-preload.cjs",
      "src/local-shell.*",
      "src/icon.png",
      "src/projects/codex.cjs",
      "src/projects/settings.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/app.ico",
      "signExecutable": false,
      "target": [
        "dir"
      ]
    }
  }
}
