{
  "name": "library-cleaner-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "ChatGPT 云端资料库的本地桌面管理工具",
  "author": "Local build",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.cjs",
    "start": "npm run prepare:app && electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "npm run prepare:app && electron . --smoke-test",
    "dist": "npm run prepare:app && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "opencc-js": "1.4.2"
  },
  "build": {
    "appId": "local.librarycleaner.desktop",
    "productName": "资料库管家",
    "executableName": "LibraryCleaner",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "bridge",
        "to": "bridge"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/app.ico",
      "signExecutable": false,
      "target": [
        "dir"
      ]
    }
  }
}
